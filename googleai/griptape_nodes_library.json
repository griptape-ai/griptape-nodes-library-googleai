                        "display_name": "Google",
                        "terms_url": "https://policies.google.com/terms/generative-ai",
                        "notes": "Reached through Vertex AI with service-account credentials, or through the AI Studio API with GOOGLE_API_KEY. Model ids are the same on both surfaces.",
                        "models": {
                            "veo_3_1_generate": {
                                "display_name": "Veo 3.1",
                                "family": "Veo 3.1",
                                "provider_model_id": "veo-3.1-generate-001",
                                "key_support": "REQUIRES_CUSTOMER_KEY"
                            },
                            "veo_3_1_fast_generate": {
                                "display_name": "Veo 3.1 Fast",
