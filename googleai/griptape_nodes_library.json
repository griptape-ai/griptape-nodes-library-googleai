{
    "name": "Google AI Library",
    "library_schema_version": "0.11.0",
    "settings": [
        {
            "description": "Google Cloud authentication settings for AI services",
            "category": "app_events.on_app_initialization_complete",
            "contents": {
                "GOOGLE_CLOUD_BUCKET_NAME": "griptape-nodes",
                "secrets_to_register": [
                    "GOOGLE_WORKLOAD_IDENTITY_CONFIG_PATH",
                    "GOOGLE_SERVICE_ACCOUNT_FILE_PATH",
                    "GOOGLE_CLOUD_PROJECT_ID",
                    "GOOGLE_APPLICATION_CREDENTIALS_JSON",
                    "GOOGLE_API_KEY"
                ]
            }
        }
    ],
    "metadata": {
        "author": "Griptape",
        "description": "A Griptape Nodes library for interacting with Google AI services like Veo, Gemini and Lyria.",
        "url": "www.griptape.ai",
        "library_version": "0.6.0",
        "engine_version": "0.98.0",
        "tags": [
            "Griptape",
            "Google",
            "AI",
            "Veo",
            "Lyria",
            "Gemini",
            "Video Generation",
            "Audio Generation",
            "Image Generation"
        ],
        "dependencies": {
            "pip_dependencies": [
                "google-auth>=2.40.0",
                "google-cloud-storage>=2.19.0",
                "google-genai>=2.10.0",
                "pillow>=11.0.0",
                "requests>=2.32.3"
            ]
        },
        "declarations": [
            {
                "type": "lifecycle_stage",
                "stage": "STABLE"
            },
