                "deprecation": {
                    "deprecation_message": "Google shuts down gemini-2.5-flash-image, the only model this node can use, on 2 October 2026. Open the node and use its migrate buttons to rebuild it as Nano Banana 2 or Nano Banana Pro, carrying over values and connections.",
                    "removal_version": "0.8.0"
                },
                "declarations": [
                    {
                        "type": "lifecycle_stage",
                        "stage": "DEPRECATED"
                    },
                    {
                        "type": "model_usage",
                        "model_ids": [
                            "gemini_2_5_flash_image"
                        ]
                    }
                ]
            }
        },
