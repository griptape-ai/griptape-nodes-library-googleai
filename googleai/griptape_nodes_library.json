    "nodes": [
        {
            "class_name": "VertexAIImageGenerator",
            "file_path": "imagen_image_generator.py",
            "metadata": {
                "category": "image/googleai",
                "description": "Deprecated: Google has shut down every Imagen model this node offers. Migrate to Nano Banana 2 or Nano Banana Pro.",
                "display_name": "Imagen Image Generator",
                "tags": [
                    "image",
                    "imagen",
                    "google",
                    "retired",
                    "deprecated"
                ],
                "deprecation": {
                    "deprecation_message": "Google shut down the Imagen 4.0 models on 17 August 2026 and the Imagen 3.0 models on 10 November 2025. Every model in this node's dropdown now returns 404, so no configuration of it can generate an image. Open the node and use its migrate buttons to rebuild it as Nano Banana 2 or Nano Banana Pro, carrying over values and connections.",
                    "removal_version": "0.8.0"
                },
                "declarations": [
                    {
                        "type": "lifecycle_stage",
                        "stage": "DEPRECATED"
                    }
                ]
            }
        },
        {
            "class_name": "GeminiImageGenerator",
            "file_path": "gemini_image_generator.py",
            "metadata": {
                "category": "image/googleai",
                "description": "Deprecated: Google removes Gemini 2.5 Flash Image on 2 October 2026. Migrate to Nano Banana 2 or Nano Banana Pro.",
                "display_name": "Nano Banana Image Generator",
                "tags": [
                    "image",
                    "gemini",
                    "google",
                    "nano banana",
                    "retired",
                    "deprecated"
